rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && getUserRole() == 'student';
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.members.hasAny([request.auth.uid])
      );
      allow delete: if isAdmin();
    }

    // Theses collection
    match /theses/{thesisId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && getUserRole() == 'student';
      allow update: if isAuthenticated() && (
        isAdmin() ||
        getUserRole() == 'adviser' ||
        // Student can update only their group's thesis
        exists(/databases/$(database)/documents/groups/$(resource.data.groupId)) &&
        get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members.hasAny([request.auth.uid])
      );
      allow delete: if isAdmin();
    }

    // Submissions collection
    match /submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && getUserRole() == 'student';
      allow update: if isAuthenticated() && (isAdmin() || getUserRole() == 'adviser');
      allow delete: if isAdmin();
    }

    // Adviser applications
    match /adviserApplications/{appId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && getUserRole() == 'adviser';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Panel assignments
    match /panelAssignments/{assignId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Evaluations
    match /evaluations/{evalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && getUserRole() == 'panel';
      allow update: if isAuthenticated() && getUserRole() == 'panel' && isOwner(resource.data.panelMemberId);
      allow delete: if isAdmin();
    }

    // Comments
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.authorId) || isAdmin();
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
    }

    // Notifications — users can only read their own
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAdmin();
    }

    // Defense schedules
    match /defenseSchedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Proposal documents (inline editor content)
    match /proposalDocuments/{thesisId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        isAdmin() ||
        getUserRole() == 'adviser' ||
        getUserRole() == 'student'
      );
      allow delete: if isAdmin();
    }

    // Inline comments (adviser highlights on proposal)
    match /inlineComments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && getUserRole() == 'adviser';
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isOwner(resource.data.authorId)
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        isOwner(resource.data.authorId)
      );
    }
  }
}
